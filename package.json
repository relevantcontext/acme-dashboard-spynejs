{
  "name": "acme-dashboard-spynejs",
  "version": "0.0.1",
  "description": "SpyneJS version of NextJS Acme Dashboard",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "concurrently --kill-others --names \"web,api\" --prefix-colors \"cyan,magenta\" \"webpack serve --open\" \"npm run start:api\"",
    "start:api": "node --env-file=.env server/app.js",
    "start:web": "webpack serve --open",
    "build": "webpack --mode production --env build",
    "lint": "eslint --config eslint.config.js",
    "lint:fix": "eslint --config eslint.config.js --fix",
    "format": "prettier --write 'src/**/*.{js,css,scss,html}'"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.2.4",
    "express": "^5.2.1",
    "postgres": "^3.4.9",
    "ramda": "^0.30.1",
    "rxjs": "^7.8.1",
    "spyne": "^0.26.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@spynejs/cms": "^0.4.4",
    "@spynejs/cms-adapter": "^0.1.3",
    "@tailwindcss/forms": "^0.5.11",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-junit-reporter": "^0.7.2",
    "@web/test-runner-mocha": "^0.9.0",
    "autoprefixer": "^10.4.20",
    "chai": "^5.1.2",
    "concurrently": "^10.0.4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-mocha": "^11.3.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-webpack-plugin": "^6.0.0",
    "file-loader": "^6.2.0",
    "globals": "^15.14.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.1",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.5.0",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.84.0",
    "sass-loader": "^16.0.4",
    "sass-migrator": "^2.5.6",
    "spyne-cli": "^0.6.2",
    "spyne-plugin-console": "^0.5.5",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spynejs/spyne"
  },
  "author": "SpyneJS",
  "license": "MIT",
  "homepage": "https://spynejs.com",
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
